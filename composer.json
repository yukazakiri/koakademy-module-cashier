{
    "name": "koakademy/cashier",
    "description": "Cashier workflows for student balance lookup and payment posting.",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "KoAkademy contributors"
        }
    ],
    "require": {
        "php": ">=8.5 <8.6",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.0",
        "nwidart/laravel-modules": "^13.0"
    },
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Cashier\\": "app/",
            "Modules\\Cashier\\Database\\Factories\\": "database/factories/",
            "Modules\\Cashier\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Cashier\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Cashier\\Providers\\CashierServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "scripts": {
        "test": "pest --compact tests/Unit/PackageContractTest.php"
    }
}
